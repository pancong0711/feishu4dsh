# Example user-level systemd unit for the feishu4dsh sandbox broker.
#
# Install it as the Unix account that owns the rootless Docker daemon. The
# broker is independent from dsh-feishu4dsh.service and must not be exposed on
# TCP/LAN. Prefer the generated installer instead of copying this file by hand:
#   bash scripts/install-user-services.sh --dry-run --only broker
#   bash scripts/install-user-services.sh --enable --only broker
#   bash scripts/install-user-services.sh --check  --only broker
#
# The current broker client assumes the same Unix account and default socket
# path as the channel process. Do not split the two services across accounts
# unless you also provide a reviewed cross-user socket/ACL design.
[Unit]
Description=feishu4dsh sandbox broker (host-local Unix socket)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Replace with the target user's deployment/source path.
WorkingDirectory=%h/feishu4dsh
Environment=HOME=%h
# Prefer an absolute Node.js path; the wrapper honors NODE_BIN.
Environment=NODE_BIN=/usr/local/bin/node
Environment=PATH=/usr/local/bin:%h/.npm-global/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/env bash %h/feishu4dsh/scripts/sandbox-broker.sh serve --socket %h/.local/share/feishu4dsh/broker/broker.sock --registry %h/.local/share/feishu4dsh/broker/registry.json
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
