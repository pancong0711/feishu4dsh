{
  "$schema": "urn:dsh-std:community-draft:dsh-plugin:0.15",
  "manifestVersion": "0.15",
  "id": "io.github.pancong0711.feishu4dsh",
  "name": "feishu4dsh",
  "version": "0.4.2",
  "facets": {
    "host": {
      "entry": "lib/std/host.js",
      "apiVersion": "v1alpha1"
    }
  },
  "requires": {
    "contracts": []
  },
  "permissions": [],
  "contributes": {
    "commands": [
      {
        "id": "io.github.pancong0711.feishu4dsh.command.help",
        "title": "查看命令列表",
        "description": "list commands"
      },
      {
        "id": "io.github.pancong0711.feishu4dsh.command.new",
        "title": "开启新会话（清空上下文）",
        "description": "start a fresh session (clears context)"
      },
      {
        "id": "io.github.pancong0711.feishu4dsh.command.stop",
        "title": "停止当前任务",
        "description": "stop the current task"
      },
      {
        "id": "io.github.pancong0711.feishu4dsh.command.status",
        "title": "查看会话 / 当前工作区 / 模型",
        "description": "show session / current workspace / model"
      },
      {
        "id": "io.github.pancong0711.feishu4dsh.command.ws",
        "title": "列出可用工作区",
        "description": "list available workspaces"
      },
      {
        "id": "io.github.pancong0711.feishu4dsh.command.ws-add",
        "title": "添加一个可用工作区（手机上添加）",
        "description": "add a workspace (from your phone)"
      },
      {
        "id": "io.github.pancong0711.feishu4dsh.command.ws-remove",
        "title": "移除一个已添加的工作区",
        "description": "remove an added workspace"
      },
      {
        "id": "io.github.pancong0711.feishu4dsh.command.cd",
        "title": "切换当前会话的工作区",
        "description": "switch the current workspace"
      },
      {
        "id": "io.github.pancong0711.feishu4dsh.command.model",
        "title": "切换当前会话模型",
        "description": "switch the session model"
      }
    ]
  },
  "subscriptions": [],
  "license": "MIT",
  "source": {
    "repository": "https://github.com/pancong0711/feishu4dsh.git"
  }
}
